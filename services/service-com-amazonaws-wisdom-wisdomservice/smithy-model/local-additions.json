          { "value": "CREATE_FAILED", "name": "CREATE_FAILED" },
          { "value": "CREATED", "name": "CREATED" },
          { "value": "DELETE_IN_PROGRESS", "name": "DELETE_IN_PROGRESS" },
          { "value": "DELETE_FAILED", "name": "DELETE_FAILED" },
          { "value": "DELETED", "name": "DELETED" },
          { "value": "UPDATE_IN_PROGRESS", "name": "UPDATE_IN_PROGRESS" },
          { "value": "UPDATE_FAILED", "name": "UPDATE_FAILED" }
        ]
      }
