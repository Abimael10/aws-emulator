      "type": "list",
      "member": { "target": "com.amazonaws.wisdom#ContactAttributeKey" },
      "traits": {
        "smithy.api#uniqueItems": {},
        "smithy.api#sensitive": {}
      }
    },
    "com.amazonaws.wisdom#ContactAttributeKey": { "type": "string" }
